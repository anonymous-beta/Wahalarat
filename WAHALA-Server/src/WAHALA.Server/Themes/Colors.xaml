<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="DeepGreenColor">#0B3B24</Color>
    <Color x:Key="MidGreenColor">#1B7A3D</Color>
    <Color x:Key="AccentGreenColor">#2E8B57</Color>
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    <Color x:Key="OffWhiteColor">#F4F4F4</Color>
    <Color x:Key="DarkTextColor">#1A1A1A</Color>
    <Color x:Key="MutedTextColor">#666666</Color>

    <SolidColorBrush x:Key="DeepGreenBrush" Color="{StaticResource DeepGreenColor}"/>
    <SolidColorBrush x:Key="MidGreenBrush" Color="{StaticResource MidGreenColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}"/>
    <SolidColorBrush x:Key="OffWhiteBrush" Color="{StaticResource OffWhiteColor}"/>
    <SolidColorBrush x:Key="DarkTextBrush" Color="{StaticResource DarkTextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
</ResourceDictionary>
