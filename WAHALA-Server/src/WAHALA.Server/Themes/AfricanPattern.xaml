<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DrawingBrush x:Key="AfricanTrianglePattern" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource DeepGreenBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,40,40"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="Transparent" Geometry="M 0,40 L 20,20 L 40,40 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource WhiteBrush}" Thickness="1.5"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 20,20 L 40,0 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource WhiteBrush}" Thickness="1.5"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
