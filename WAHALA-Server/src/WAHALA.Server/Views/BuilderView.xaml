<UserControl x:Class="WAHALA.Server.Views.BuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WAHALA.Server.ViewModels">
    <UserControl.DataContext>
        <vm:BuilderViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Builder" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DeepGreenBrush}" Margin="0,0,0,20"/>

        <!-- Main Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="15" ShadowDepth="2"/>
            </Border.Effect>
            
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- Windows Tab -->
                <TabItem Header="Windows Stub">
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="C2 Server:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,20"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding C2Server}" Margin="0,0,0,20"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="C2 Port:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,20"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding C2Port}" Margin="0,0,0,20"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="AES Key (Base64):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,20"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AesKeyBase64}" Margin="0,0,0,20"/>

                        <Button Grid.Row="3" Grid.Column="1" Content="Generate New Key" Command="{Binding GenerateKeyCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Background="#F3F4F6" Foreground="{StaticResource DeepGreenBrush}"/>
                    </Grid>
                </TabItem>

                <!-- Android Tab -->
                <TabItem Header="Android APK">
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="App Name:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,20"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AppName}" Margin="0,0,0,20"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Package Name:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,20"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PackageName}" Margin="0,0,0,20"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="C2 URL:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,20"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding C2Server, StringFormat='ws://{0}'}" IsReadOnly="True" Background="#F9FAFB" Margin="0,0,0,20"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Build Buttons Area -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Build Windows" Command="{Binding BuildWindowsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,15,0"/>
                <Button Content="Build Android" Command="{Binding BuildAndroidCommand}" Style="{StaticResource ActionButton}"/>
            </StackPanel>
            
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{StaticResource AccentGreenBrush}"/>
        </Grid>
    </Grid>
</UserControl>