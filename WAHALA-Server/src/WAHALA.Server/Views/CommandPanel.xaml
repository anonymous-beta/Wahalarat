<UserControl x:Class="WAHALA.Server.Views.CommandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Command Panel" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DeepGreenBrush}" Margin="0,0,0,10"/>
        
        <TextBlock Text="Selected Client:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBlock Text="{Binding SelectedClient.IPAddress, TargetNullValue='None'}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,15"/>

        <TextBlock Text="Available Modules:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding AvailableModules}" x:Name="ModuleCombo" Margin="0,0,0,10"/>

        <TextBlock Text="Action:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="ActionBox" Margin="0,0,0,10"/>

        <TextBlock Text="Payload:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="PayloadBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Button Content="Send Command" Click="SendButton_Click" Background="{StaticResource MidGreenBrush}" Foreground="White" Padding="10,5"/>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>