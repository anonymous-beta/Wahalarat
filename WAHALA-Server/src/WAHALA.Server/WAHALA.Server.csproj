<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WAHALA Server</AssemblyName>
    <RootNamespace>WAHALA.Server</RootNamespace>
    <ApplicationIcon>Assets\monkey-logo.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Company>Anonymous-beta</Company>
    <Product>WAHALA RAT</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\monkey-logo.png" />
  </ItemGroup>

</Project>
