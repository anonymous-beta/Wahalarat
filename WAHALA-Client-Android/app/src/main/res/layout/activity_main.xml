<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07120D"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Brand header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#16472D"
                android:gravity="center"
                android:text="W"
                android:textColor="#70F0A2"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WAHALARAT"
                    android:textColor="#F1FFF6"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SECURITY MANAGEMENT"
                    android:textColor="#83A994"
                    android:textSize="10sp"
                    android:letterSpacing="0.12" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#153524"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="LOCAL"
                android:textColor="#70F0A2"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Main status card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#102219"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM OVERVIEW"
                android:textColor="#83A994"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="APPLICATION READY"
                android:textColor="#F1FFF6"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="18dp"
                android:background="#294535" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android API"
                android:textColor="#B4CDBD"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Operating mode -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:text="OPERATING MODE"
            android:textColor="#83A994"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0D1B13"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Local-only mode"
                android:textColor="#70F0A2"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="The application is running without a remote management session or background monitoring."
                android:textColor="#B4CDBD"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Security information -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:text="SECURITY STATUS"
            android:textColor="#83A994"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/securityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#102219"
            android:lineSpacingExtra="7dp"
            android:padding="18dp"
            android:text="Security information"
            android:textColor="#D0E5D7"
            android:textSize="13sp" />

        <!-- Actions -->

        <Button
            android:id="@+id/statusButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1B7A3D"
            android:text="Refresh Status"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/informationButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1A3023"
            android:text="Security Information"
            android:textAllCaps="false"
            android:textColor="#CDE8D7"
            android:textSize="15sp" />

        <!-- Footer -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:text="WAHALARAT  •  TRANSPARENT BY DESIGN"
            android:textColor="#63816E"
            android:textSize="10sp"
            android:letterSpacing="0.04" />

    </LinearLayout>

</ScrollView>